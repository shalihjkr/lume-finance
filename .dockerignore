# Allowlist the build context: local files are excluded unless needed at runtime.
**
!Dockerfile
!.dockerignore
!requirements.txt
!app.py
!database.py
!gunicorn.conf.py
!app/
!app/**
!docker/
!docker/healthcheck.py

# These exclusions also apply if accidentally placed beneath app/.
**/.git
**/.git/**
**/.venv
**/.venv/**
**/venv
**/venv/**
**/env
**/env/**
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/.pytest_cache
**/.pytest_cache/**
**/.env*
**/*.env
**/.aws/**
**/.ssh/**
**/*secret*
**/credentials*
**/*.pem
**/*.key
**/*.sqlite*
**/*.db
**/*.db-*
**/*.bak
**/*.backup
**/backups/**
**/instance/**
**/.coverage*
**/htmlcov/**
**/reports/**
**/.idea/**
**/.vscode/**
**/*.log
**/*.tmp
**/*.swp
**/*~
**/.DS_Store
**/Thumbs.db
